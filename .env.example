# Copy this file to .env and adjust. Never commit .env.

# Where Odoo runs (docker/compose.yml publishes it on port 8069).
ODOO_URL=http://localhost:8069

# Database manager ("master") password. docker/compose.yml reads it from .env too.
ODOO_MASTER_PASSWORD=admin

# The database the suite creates and uses.
ODOO_DB=playwright

# Administrator of that database. Used only for setup and API checks.
ODOO_ADMIN_LOGIN=admin
ODOO_ADMIN_PASSWORD=admin

# Company country, used to pick the chart of accounts when the database is created.
ODOO_COUNTRY=US
ODOO_LANG=en_US

# Password given to every role user (sales, purchase, warehouse, accounting).
ODOO_USER_PASSWORD=Playwright-1234
